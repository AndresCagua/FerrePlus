# PostgreSQL externo/local del host Linux. Compose NO crea ni administra PostgreSQL.
# Usa la instancia existente en host.docker.internal:5432; no borres su contenedor/volumen.
# La password real debe vivir solo en el .env local ignorado por Git.
POSTGRES_DB=ferreplus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password

# Credenciales del MongoDB propiedad exclusiva de public-api.
MONGO_DATABASE=ferreplus_public
MONGO_ROOT_USERNAME=ferreplus
MONGO_ROOT_PASSWORD=replace-with-a-local-password

# Redis es interno para los contenedores; este puerto loopback permite DataGrip/pruebas locales.
REDIS_URL=redis://:replace-with-a-long-random-value@redis:6379

# Credenciales del almacenamiento privado MinIO.
MINIO_ROOT_USER=ferreplus
MINIO_ROOT_PASSWORD=replace-with-a-long-local-password
MINIO_ENDPOINT=http://minio:9000
MINIO_CV_BUCKET=cv-bucket
MINIO_MEDIA_BUCKET=media-bucket

# Secreto opcional para el tunnel; apunta a un archivo fuera de Git.
CLOUDFLARED_TOKEN_FILE=./secrets/cloudflared.token

# API key opcional para funcionalidades Gemini del admin-api.
GEMINI_API_KEY=replace-with-your-gemini-api-key
APP_JWT_SECRET=replace-with-a-long-random-admin-jwt-secret

# URLs internas/publicas previstas para los siguientes PRs.
PUBLIC_API_URL=http://public-api:8080
ADMIN_API_URL=http://admin-api:8080
APP_CORS_ALLOWED_ORIGINS=http://admin.localhost:8088,http://public.localhost:8088,http://localhost:4200

# SMTP: sera consumido por public-api en PR5.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.test

# Identidad S2S: las claves se montan como secretos, no se versionan.
S2S_ISSUER=ferreplus-admin-api
S2S_AUDIENCE=ferreplus-public-api
S2S_KEY_ID=bootstrap

# Puertos publicados por Traefik.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Puertos de desarrollo publicados SOLO en 127.0.0.1 para DataGrip/pruebas.
# No se incluye una variable de bind address para impedir una exposicion accidental
# en 0.0.0.0. Para produccion, elimina estas variables y los bloques `ports:` de
# MongoDB, Redis y MinIO en docker-compose.yml; los servicios conservaran sus
# puertos internos y las redes de datos.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
ADMIN_WEB_HOST_PORT=4200

# Perfil opcional: tunnel no inicia por defecto. Compose usa prod por defecto;
# selecciona dev o test de forma explicita para desarrollo/pruebas locales.
COMPOSE_PROFILES=
SPRING_PROFILES_ACTIVE=dev

# Limites iniciales de desarrollo documentados en design.md.
ADMIN_API_MEMORY_LIMIT=768M
ADMIN_API_CPU_LIMIT=1.00
PUBLIC_API_MEMORY_LIMIT=768M
PUBLIC_API_CPU_LIMIT=1.00
MONGO_MEMORY_LIMIT=768M
REDIS_MEMORY_LIMIT=256M
MINIO_MEMORY_LIMIT=512M
S2S_PRIVATE_KEY_FILE=./secrets/s2s-private-key.pem
S2S_INITIAL_PUBLIC_KEY_FILE=./secrets/s2s-public-key.pem
S2S_TOKEN_LIFETIME=120s
REDIS_PASSWORD=replace-with-a-long-random-value

# Cloudflare Turnstile: secret solo backend; site key es publica para Astro.
# CAPTCHA_ENABLED=false solo es valido con SPRING_PROFILES_ACTIVE=dev o test.
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
PUBLIC_CAPTCHA_ENABLED=false
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_TIMEOUT=3s
RATE_LIMIT_TRUSTED_PROXY_HEADER=X-Forwarded-For
RATE_LIMIT_FINGERPRINT_HMAC_SECRET=replace-with-a-long-random-value
# La API publica mantiene Actuator en un bind/puerto local del contenedor;
# api.localhost solo alcanza el puerto funcional 8080.
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
