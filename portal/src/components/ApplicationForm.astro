---
interface Props { convocatoriaId: string; }
const { convocatoriaId } = Astro.props;
---
<aside class="card form-shell"><div class="eyebrow">Da el siguiente paso</div><h2>Postulate</h2><form data-convocatoria-id={convocatoriaId} novalidate><label>Nombres<input name="nombres" required maxlength="100" autocomplete="given-name" /></label><label>Apellidos<input name="apellidos" required maxlength="100" autocomplete="family-name" /></label><label>Email<input type="email" name="email" required maxlength="254" autocomplete="email" /></label><label>Telefono<input name="telefono" required maxlength="30" autocomplete="tel" /></label><label>Ciudad<input name="ciudad" required maxlength="100" /></label><label>Hoja de vida <span class="date">PDF, DOC o DOCX · maximo 5 MB</span><input type="file" name="cv" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" /></label><label class="honeypot" aria-hidden="true">No completar<input name="honeypot" tabindex="-1" autocomplete="off" /></label><div data-status class="status" hidden role="status" aria-live="polite"></div><button class="button" type="submit">Enviar postulacion</button></form></aside><script>import { setupApplicationForm } from './islands/ApplicationForm'; document.querySelectorAll('form[data-convocatoria-id]').forEach((form) => setupApplicationForm(form as HTMLFormElement));</script>
