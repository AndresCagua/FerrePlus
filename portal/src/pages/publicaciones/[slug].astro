---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { publicApi } from '../../lib/api-client/public-api'; import type { Publicacion } from '../../lib/api-client/types';
export async function getStaticPaths() { let items: Publicacion[] = []; try { items = await publicApi.publicaciones(); } catch {} return items.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props as { item: Publicacion }; const description = item.metadataSEO?.description ?? item.resumen ?? 'Publicacion de Ferreplus.'; const jsonLd = { '@context':'https://schema.org', '@type':'Article', headline:item.metadataSEO?.title ?? item.titulo, description, datePublished:item.fechaPublicacion, url:Astro.url.href };
---
<BaseLayout title={item.metadataSEO?.title ?? item.titulo} description={description} canonical={item.metadataSEO?.canonical} type="article" jsonLd={jsonLd}><article class="container article" data-publicacion-detail><div class="eyebrow">{item.categoria ?? 'Publicacion'}</div><h1>{item.titulo}</h1>{item.fechaPublicacion && <div class="date">{new Date(item.fechaPublicacion).toLocaleDateString('es-CO')}</div>}<p class="lede">{item.resumen}</p><div class="article-content">{item.descripcion}</div></article><script>import { setupPublicacionDetail } from '../../components/islands/PublicContent'; setupPublicacionDetail();</script></BaseLayout>
