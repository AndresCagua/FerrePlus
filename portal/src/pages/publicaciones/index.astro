---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Card from '../../components/Card.astro'; import { publicApi } from '../../lib/api-client/public-api'; import type { Publicacion } from '../../lib/api-client/types';
let publicaciones: Publicacion[] = []; let unavailable = false;
try { publicaciones = await publicApi.publicaciones(); } catch { unavailable = true; }
---
<BaseLayout title="Publicaciones" description="Ideas, novedades e historias de Ferreplus."><section class="section"><div class="container"><div class="eyebrow">Cartelera</div><h1>Publicaciones</h1>{unavailable && <p class="notice">El contenido se esta actualizando. Vuelve a intentarlo pronto.</p>}{publicaciones.length ? <div class="grid">{publicaciones.map((item) => <Card href={`/publicaciones/${item.slug}/`} title={item.titulo} summary={item.resumen ?? item.descripcion} eyebrow={item.categoria} date={item.fechaPublicacion ? new Date(item.fechaPublicacion).toLocaleDateString('es-CO') : undefined} />)}</div> : <div class="empty">Todavia no hay publicaciones disponibles.</div>}</div></section></BaseLayout>
