---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Card from '../../components/Card.astro'; import { publicApi } from '../../lib/api-client/public-api'; import type { Publicacion } from '../../lib/api-client/types';
let publicaciones: Publicacion[] = []; let unavailable = false; let ssrLoading = false;
try { publicaciones = await publicApi.publicaciones(); } catch { if (import.meta.env.PUBLIC_API_URL) unavailable = true; else ssrLoading = true; }
---
<BaseLayout title="Publicaciones" description="Ideas, novedades e historias de Ferreplus."><section class="section"><div class="container"><div class="eyebrow">Cartelera</div><h1>Publicaciones</h1><div class="grid" data-publicaciones-list>{unavailable && <div class="notice" data-content-state="error" data-state-origin="ssr" role="alert" aria-live="assertive">El contenido se esta actualizando. Vuelve a intentarlo pronto.</div>}{ssrLoading && <div class="empty" data-content-state="loading" data-state-origin="ssr" role="status" aria-live="polite">Cargando publicaciones...</div>}{publicaciones.map((item) => <Card href={`/publicaciones/detail/?slug=${encodeURIComponent(item.slug)}`} title={item.titulo} summary={item.resumen ?? item.descripcion} eyebrow={item.categoria} date={item.fechaPublicacion ? new Date(item.fechaPublicacion).toLocaleDateString('es-CO') : undefined} />)}{!publicaciones.length && !unavailable && !ssrLoading && <div class="empty" data-content-state="empty" data-state-origin="ssr" role="status" aria-live="polite">Todavia no hay publicaciones disponibles.</div>}</div></div></section><script>import { setupPublicacionesList } from '../../components/islands/PublicContent'; setupPublicacionesList();</script></BaseLayout>
