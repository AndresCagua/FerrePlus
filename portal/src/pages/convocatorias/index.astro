---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Card from '../../components/Card.astro'; import { publicApi } from '../../lib/api-client/public-api'; import type { Convocatoria } from '../../lib/api-client/types';
let convocatorias: Convocatoria[] = []; let unavailable = false; try { convocatorias = await publicApi.convocatorias(); } catch { unavailable = true; }
---
<BaseLayout title="Convocatorias" description="Encuentra oportunidades abiertas para trabajar en Ferreplus."><section class="section"><div class="container"><div class="eyebrow">Talento</div><h1>Convocatorias abiertas</h1>{unavailable && <p class="notice">No podemos consultar las oportunidades ahora. Vuelve a intentarlo pronto.</p>}{convocatorias.length ? <div class="grid">{convocatorias.map((job) => <Card href={`/convocatorias/${job.id}/`} title={job.titulo} summary={job.descripcion} eyebrow={job.modalidad ?? 'Oportunidad'} date={job.fechaCierre ? `Cierra ${new Date(job.fechaCierre).toLocaleDateString('es-CO')}` : undefined} />)}</div> : <div class="empty">No hay convocatorias abiertas en este momento.</div>}</div></section></BaseLayout>
