---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Card from '../../components/Card.astro'; import { publicApi } from '../../lib/api-client/public-api'; import type { Convocatoria } from '../../lib/api-client/types';
let convocatorias: Convocatoria[] = []; let unavailable = false; let ssrLoading = false;
try { convocatorias = await publicApi.convocatorias(); } catch { if (import.meta.env.PUBLIC_API_URL) unavailable = true; else ssrLoading = true; }
---
<BaseLayout title="Convocatorias" description="Encuentra oportunidades abiertas para trabajar en Ferreplus."><section class="section"><div class="container"><div class="eyebrow">Talento</div><h1>Convocatorias abiertas</h1><div class="grid" data-convocatorias-list>{unavailable && <div class="notice" data-content-state="error" data-state-origin="ssr" role="alert" aria-live="assertive">No podemos consultar las oportunidades ahora. Vuelve a intentarlo pronto.</div>}{ssrLoading && <div class="empty" data-content-state="loading" data-state-origin="ssr" role="status" aria-live="polite">Cargando convocatorias...</div>}{convocatorias.map((job) => <Card href={`/convocatorias/${job.id}/`} title={job.titulo} summary={job.descripcion} eyebrow={job.modalidad ?? 'Oportunidad'} date={job.fechaCierre ? `Cierra ${new Date(job.fechaCierre).toLocaleDateString('es-CO')}` : undefined} />)}{!convocatorias.length && !unavailable && !ssrLoading && <div class="empty" data-content-state="empty" data-state-origin="ssr" role="status" aria-live="polite">No hay convocatorias abiertas en este momento.</div>}</div></div></section><script>import { setupConvocatoriasList } from '../../components/islands/PublicContent'; setupConvocatoriasList();</script></BaseLayout>
